{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "name": "session_start_checks",
                        "command": "bash .claude/hooks/session-start.sh",
                        "timeout": 90
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "name": "rust_quality_gate",
                        "command": "bash .claude/hooks/rust-quality-gate.sh"
                    },
                    {
                        "type": "command",
                        "name": "perf_trigger",
                        "command": "bash .claude/hooks/perf-trigger.sh",
                        "timeout": 15
                    }
                ]
            }
        ]
    }
}